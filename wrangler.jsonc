{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "no-stupid-questions",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/data/*", "/api/*"]
  },
  "vars": {
    "GITHUB_REPO": "oschmidek-collab/no-stupid-questions"
  },
  // Keep variables and secrets set in the Cloudflare dashboard (GITHUB_TOKEN) across deploys.
  "keep_vars": true
}
